@PACKAGE_INIT@
include("${CMAKE_CURRENT_LIST_DIR}/zcrudpTargets.cmake")
foreach(component IN ITEMS core config codec reliability session io profiles stream scalar motion)
  if(TARGET zcrudp::${component})
    set(zcrudp_${component}_FOUND TRUE)
  else()
    set(zcrudp_${component}_FOUND FALSE)
  endif()
endforeach()
check_required_components(zcrudp)
